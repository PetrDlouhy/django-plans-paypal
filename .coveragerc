[run]
branch = true
# sysmon, the default core on Python 3.14+, does not run file-tracer plugins.
core = ctrace
plugins =
    django_coverage_plugin

[report]
omit =
    *site-packages*
    */tests/*
    *.tox*
   */migrations/*,
include = plans_paypal/*
show_missing = True
exclude_lines =
    raise NotImplementedError
